# Rust build output (yours goes to D:\cargo-target, but this catches any stray ones)
target/
**/target/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Preview renders and other generated media
preview/out/
preview/output/
*.mp4
*.mov
*.webm
*.gif
*.png
!docs/**/*.png

# Music: never commit copyrighted tracks
*.mp3
*.wav
*.flac
*.m4a
*.ogg

# Saved local settings, presets and logs from your machine
*.local.json
settings.json
*.log

# Windows / OneDrive / editor clutter
Thumbs.db
desktop.ini
.vscode/
.idea/
# Installer build output and downloaded redistributable
installer/output/
installer/redist/

# Android build output: the Rust library copied in for packaging, Gradle's
# working folders, the finished APK, and any signing key
android/app/src/main/jniLibs/
android/.gradle/
android/build/
android/app/build/
android/output/
android/local.properties
*.keystore
*.jks
