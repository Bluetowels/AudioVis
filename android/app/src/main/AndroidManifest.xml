<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The microphone, and (Android counts it as recording) what other apps play. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Capturing other apps has to run in a service that shows a notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Looking lyrics up on lrclib.net, only while "Show lyrics" is on. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- A USB MIDI controller is optional. -->
    <uses-feature android:name="android.software.midi" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="AudioVis"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <!-- The screen is drawn by the Rust library named in lib_name. Every
             kind of change is listed so that turning the phone or plugging
             something in never restarts the app. -->
        <!-- Where the app opens. It goes straight on to MainActivity, unless
             the app stopped by itself last time, when it first says why. -->
        <activity
            android:name=".StartActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|layoutDirection|locale|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <meta-data android:name="android.app.lib_name" android:value="audiovis" />
        </activity>

        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Lets the app learn what other apps are playing (title, artist,
             cover, position) once the user switches it on under
             notification access in Android's settings. See MediaListener. -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="AudioVis (to see what is playing)"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
